generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// The one account that can log in to /admin
model Admin {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}

// Singleton-ish table: in practice we only ever use the first row.
model Profile {
  id         String  @id @default(cuid())
  name       String
  title      String
  bio        String
  skills     String  @default("")
  email      String
  location   String?
  resumeUrl  String?
  githubUrl  String?
  linkedinUrl String?
  twitterUrl String?
  updatedAt  DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  company     String
  role        String
  startDate   String
  endDate     String?  // null/empty = "Present"
  description String
  order       Int      @default(0)
}

model Education {
  id          String   @id @default(cuid())
  school      String
  degree      String
  startDate   String
  endDate     String?
  description String?
  order       Int      @default(0)
}

model Skill {
  id       String  @id @default(cuid())
  name     String
  category String? // e.g. "Frontend", "Backend", "Tools"
  order    Int     @default(0)
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String   // comma-separated, e.g. "Next.js,Prisma,Tailwind"
  imageUrl    String?
  videoUrl    String?
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}
